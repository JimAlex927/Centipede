APP_ENV=dev
CONFIG_SOURCE=file
CONFIG_DIR=config
DOTENV_PATH=.env

# Set CONFIG_SOURCE=nacos to load config from Nacos instead.
NACOS_SERVER_ADDRS=http://127.0.0.1:8848
NACOS_NAMESPACE=
NACOS_GROUP=DEFAULT_GROUP
NACOS_DATA_ID=centipede-dev.yaml
NACOS_USERNAME=nacos
NACOS_PASSWORD=nacos
NACOS_TIMEOUT=10s
NACOS_CACHE_DIR=data/nacos/cache
NACOS_LOG_DIR=data/nacos/log
NACOS_LOG_LEVEL=warn

# Allmacht identity provider. Local authentication is active first; SSO can be
# added behind the same identity-provider boundary later.
SSO_ISSUER_URL=http://localhost:7777
SSO_CLIENT_ID=centipede.web
SSO_REDIRECT_URL=http://localhost:7788/oauth/callback
SSO_SCOPES=openid,profile,email

# Optional Google SSO credentials. The callback URL to register in Google is:
# http://localhost:7788/api/sso/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Optional OpenAI-compatible AI provider used by the Go backend.
# OPENAI_API_URL=https://api.openai.com/v1
# OPENAI_API_KEY=
# AI_DRIVER=openai-compatible
# AI_CHAT_MODEL=gpt-4o-mini
# AI_COMPLETION_MODEL=gpt-4o-mini
